{
  "name": "latex-editor",
  "productName": "Mike's",
  "version": "0.1.0",
  "description": "A local LaTeX editor for reviewing and revising papers, with an Overleaf-style visual mode",
  "author": "mikexyl",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/mikexyl/latex-editor",
  "type": "module",
  "private": true,
  "main": "build/electron/main.mjs",
  "bin": {
    "latex-editor": "bin/latex-editor.mjs"
  },
  "scripts": {
    "dev": "tsx watch --exclude 'examples/**' --exclude 'web/**' server/index.ts",
    "build": "vite build && node scripts/postbuild.mjs",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "grammar": "lezer-generator web/src/lezer-latex/latex.grammar -o web/src/lezer-latex/latex.mjs",
    "predev": "npm run grammar",
    "prebuild": "npm run grammar",
    "pretypecheck": "npm run grammar",
    "test": "npm run grammar && tsx tests/track.test.ts && tsx tests/macros.test.ts",
    "app": "node bin/latex-editor.mjs",
    "install-app": "node scripts/install-app.mjs",
    "uninstall-app": "node scripts/install-app.mjs --uninstall",
    "electron:build": "esbuild electron/main.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=build/electron/main.mjs",
    "electron:dev": "npm run grammar && npm run electron:build && electron .",
    "electron": "npm run build && npm run electron:build && NODE_ENV=production electron .",
    "tex:build": "node scripts/build-tex.mjs",
    "dist": "npm run build && npm run electron:build && electron-builder",
    "dist:mac": "npm run build && npm run electron:build && electron-builder --mac",
    "dist:linux": "npm run build && npm run electron:build && electron-builder --linux"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.5",
    "@lezer/generator": "^1.8.1",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.12",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "katex": "^0.19.1",
    "pdfjs-dist": "^6.5.438",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "build": {
    "appId": "io.github.mikexyl.latex-editor",
    "productName": "Mike's",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "package.json",
      "dist/**",
      "build/electron/**",
      "electron/preload.cjs",
      "examples/sample/**",
      "!examples/sample/.latex-editor-build",
      "LICENSE"
    ],
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build-resources/icon.icns",
      "identity": null,
      "extraResources": [
        {
          "from": "build/texlive",
          "to": "texlive",
          "filter": [
            "**/*",
            "!bin/*-linux/**"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Mike's ${version}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "build-resources/icon.png",
      "synopsis": "Review and revise LaTeX papers with a visual editor",
      "extraResources": [
        {
          "from": "build/texlive",
          "to": "texlive",
          "filter": [
            "**/*",
            "!bin/*-darwin/**"
          ]
        }
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "mikes"
        }
      },
      "executableName": "mikes"
    },
    "artifactName": "Mikes-${version}-${arch}.${ext}"
  },
  "desktopName": "mikes.desktop"
}
